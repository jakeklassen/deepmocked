{
	"name": "vitest-create-mock",
	"version": "0.0.12",
	"description": "A utility library for creating mocks in Vitest tests.",
	"keywords": [
		"mock",
		"test",
		"vitest"
	],
	"homepage": "https://github.com/jakeklassen/vitest-create-mock#readme",
	"bugs": {
		"url": "https://github.com/jakeklassen/vitest-create-mock/issues"
	},
	"license": "MIT",
	"author": "Jake Klassen <jklassendev@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jakeklassen/vitest-create-mock.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": "./dist/index.js",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"test": "vitest",
		"typecheck": "tsc --noEmit",
		"release": "bumpp && npm publish"
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^5.1.1",
		"bumpp": "^12.3.0",
		"oxfmt": "^0.79.0",
		"oxlint": "^1.94.0",
		"oxlint-tsgolint": "^7.0.2007",
		"tsdown": "^0.23.7",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	},
	"peerDependencies": {
		"vitest": "^3 || ^4 || ^5"
	},
	"packageManager": "pnpm@12.22.0"
}
